# Copia este archivo a .env para desarrollar en local.
PORT=3000
HOST=127.0.0.1
API_URL=http://127.0.0.1:8000
# Secreto compartido con la API de Laravel: el mismo valor en api/.env.
MOTOR_TOKEN=
# Clave del panel (la misma que en api/.env): la usa el websocket del panel.
PANEL_TOKEN=
# Opcional: sin clave, el asistente funciona solo con botones.
LLM_API_KEY=
LLM_MODELO=openai/gpt-oss-120b
# Opcional y con cuidado: si el bot está desplegado, en local le quitaría los mensajes (long polling).
TELEGRAM_TOKEN=
OPERADOR_CHAT_ID=
