APP_NAME="Clínica Alba API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# SQLite en local. En producción: DB_URL=postgresql://... (Neon) y DB_CONNECTION=pgsql.
DB_CONNECTION=sqlite

# La API no usa sesiones ni colas: solo caché para los límites de uso y las métricas de la demo.
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=file

ZONA_HORARIA=Europe/Madrid

# Clave del panel (cabecera X-Panel-Token).
PANEL_TOKEN=
# Secreto compartido con el motor (Node). Debe ser el mismo en los dos .env.
MOTOR_TOKEN=
MOTOR_URL=http://127.0.0.1:3000
