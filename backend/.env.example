# Copia este archivo como .env y rellena los valores.

# Token del bot, de @BotFather en Telegram.
TELEGRAM_TOKEN=

# Clave del modelo de IA (API compatible con OpenAI). Groq tiene plan gratuito: https://console.groq.com
# Si se deja vacía, el bot funciona solo con menús y botones.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELO=openai/gpt-oss-120b

# Tu chat de Telegram, para recibir un aviso cada vez que una conversación pasa a una persona.
# Para saberlo, escribe al bot y mira el chat_id de tu conversación en el panel.
OPERADOR_CHAT_ID=

# Solo en producción: URL pública del servicio (activa el modo webhook) y un secreto aleatorio para el webhook.
URL_PUBLICA=
WEBHOOK_SECRETO=

# Clave para entrar al panel de operadores. Usa una larga y aleatoria.
PANEL_TOKEN=

# Base de datos. Por defecto, SQLite en local.
DATABASE_URL=sqlite+aiosqlite:///./agente_citas.db
